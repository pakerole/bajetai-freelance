{
	email pakerole@gmail.com

	log {
		output file /logs/caddy.log {
			roll_size 100mb
			roll_keep 5
			roll_keep_for 720h
		}
		format json
		level INFO
	}

	log access {
		output file /logs/access.log {
			roll_size 100mb
			roll_keep 5
			roll_keep_for 720h
		}
		format json
		level INFO
	}
}

:80 {
	redir https://{host}{uri} permanent
}

# bajetAI Freelance Landing Page
www.bajetai.my, bajetai.my {
	handle /api/* {
		reverse_proxy host.docker.internal:8010
	}

	handle {
		reverse_proxy host.docker.internal:8030
	}

	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	tls {
		protocols tls1.2 tls1.3
	}
}

# MyRamadhan360 Production Domain
myramadhan360.bajetai.my, www.myramadhan360.bajetai.my {
	handle /health {
		reverse_proxy host.docker.internal:9051
	}

	handle /* {
		reverse_proxy host.docker.internal:9051
	}

	handle /api/* {
		reverse_proxy host.docker.internal:9050
	}

	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	tls {
		protocols tls1.2 tls1.3
	}
}
